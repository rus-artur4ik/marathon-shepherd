# Shepherd Cuttlefish Adapter
# Build from repo root:  docker build -f deploy/Dockerfile.shepherd-cuttlefish -t shepherd-cuttlefish .

# ── Stage 1: Build ──────────────────────────────────────────────────────────────
# The builder only produces JVM bytecode, so it always runs on the build host's
# native platform; only the runtime stage below is built per target architecture.
FROM --platform=$BUILDPLATFORM eclipse-temurin:25-jdk AS builder

WORKDIR /build
COPY gradlew settings.gradle.kts build.gradle.kts gradle.properties* ./
COPY gradle/ gradle/
COPY adapter/ adapter/
COPY manager/ manager/

RUN chmod +x gradlew && ./gradlew :adapter:shepherd-cuttlefish:installDist --no-daemon

# ── Stage 2: Runtime ────────────────────────────────────────────────────────────
FROM eclipse-temurin:25-jre

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl python3 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/adapter/shepherd-cuttlefish/build/install/shepherd-cuttlefish /opt/shepherd-cuttlefish

# Direct Cloud Orchestrator access is configured through CUTTLEFISH_ORCHESTRATOR_URL.
# Persist local lease state with CUTTLEFISH_ORCHESTRATOR_LEASES_PATH when possible.
ENV ADAPTER_PORT=7037
ENV ADAPTER_ADB_PORT=6520
ENV CUTTLEFISH_ORCHESTRATOR_URL=https://127.0.0.1:2443
# TLS validation stays ON in the published image. Override at run time
# (-e CUTTLEFISH_ORCHESTRATOR_INSECURE_TLS=true) only for a self-signed dev host.
ENV CUTTLEFISH_ORCHESTRATOR_INSECURE_TLS=false

EXPOSE 7037

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -sf http://localhost:7037/health || exit 1

ENTRYPOINT ["/opt/shepherd-cuttlefish/bin/shepherd-cuttlefish"]
