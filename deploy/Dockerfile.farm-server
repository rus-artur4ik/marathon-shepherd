# Multi-stage build for farm-server from mobile-test-platform
# https://github.com/open-tool/mobile-test-platform

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM eclipse-temurin:17-jdk AS builder

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth 1 https://github.com/open-tool/mobile-test-platform.git .

RUN chmod +x ./gradlew && ./gradlew :farm:server:installDist --no-daemon

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM eclipse-temurin:17-jre

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        docker.io \
        curl \
        android-tools-adb && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/farm/server/build/install/server /opt/farm-server

WORKDIR /opt/farm-server

ENTRYPOINT ["bin/server"]
