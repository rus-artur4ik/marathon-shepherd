# Shepherd ADB Adapter (test image).
#
# Ships the pre-built distribution from adapter/shepherd-adb/build/install/shepherd-adb.
# Run ./gradlew :adapter:shepherd-adb:installDist first (handled by [build] all).
FROM eclipse-temurin:25-jre

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl adb && \
    rm -rf /var/lib/apt/lists/*

COPY adapter/shepherd-adb/build/install/shepherd-adb /opt/shepherd-adb

RUN if [ ! -x /opt/shepherd-adb/bin/shepherd-adb ]; then \
      echo "ERROR: /opt/shepherd-adb/bin/shepherd-adb missing — run ./gradlew :adapter:shepherd-adb:installDist before docker build" >&2; \
      exit 1; \
    fi

ENV ADAPTER_PORT=7037
ENV ADAPTER_ADB_PORT=5037
ENV ADB_PROXY_PORT_RANGE=7600-7699

EXPOSE 7037

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -sf http://localhost:7037/health || exit 1

ENTRYPOINT ["/opt/shepherd-adb/bin/shepherd-adb"]
